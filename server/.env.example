# Copy this file to .env and fill in real values. .env is never committed.

# MongoDB Atlas connection string (Atlas -> Connect -> Drivers -> Node.js)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/accessbridge?retryWrites=true&w=majority

# Port the Express API listens on
PORT=5000

# Secret used to sign login tokens (any long random string)
JWT_SECRET=change-me-to-a-long-random-string
